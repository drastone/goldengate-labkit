REPLICAT D01
USERIDALIAS trg_ogg DOMAIN OracleGoldenGate
ASSUMETARGETDEFS
APPLYNOOPUPDATES
DISCARDFILE D01_PERF.dsc, PURGE, MEGABYTES 100
REPORTCOUNT EVERY 1 MINUTES RATE

DDL &
INCLUDE MAPPED OBJTYPE TABLE INSTR 'CREATE' &
INCLUDE MAPPED OBJTYPE TABLE INSTR 'TRUNCATE' &
INCLUDE MAPPED OBJTYPE TABLE INSTR 'DROP' &
INCLUDE MAPPED OBJTYPE TABLE INSTR 'ALTER' &
EXCLUDE MAPPED OBJTYPE SEQUENCE INSTR 'CREATE' &
EXCLUDE MAPPED OBJTYPE SEQUENCE INSTR 'DROP'

MAP SOE.*, TARGET SOE.*;
