{
  "$schema": "ogg:task",
  "description": "Purge OGGHUB trail files by checkpoint and keep at least 10 files.",
  "enabled": true,
  "schedule": {
    "every": {
      "units": "minutes",
      "value": 10
    }
  },
  "command": {
    "$schema": "ogg:command",
    "name": "purge",
    "purgeType": "trails",
    "trails": [
      { "name": "ca", "path": "dirdat" }
    ],
    "useCheckpoints": true,
    "keep": [
      { "type": "min", "units": "files", "value": 10 }
    ]
  }
}
