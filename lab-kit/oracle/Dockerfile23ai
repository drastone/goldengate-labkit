FROM oracle/database:23.26.0-ee

USER oracle

RUN /opt/oracle/runOracle.sh --nowait || true && \
        netca_log_found=0; \
        for netca_log in /opt/oracle/cfgtoollogs/netca/netca_configure_out.log /opt/oracle/cfgtoollogs/netca/*.log /opt/oracle/cfgtoollogs/netca/*.out; do \
          if [ -f "$netca_log" ]; then \
            echo "==> NETCA log: $netca_log"; \
            cat "$netca_log"; \
            netca_log_found=1; \
          fi; \
        done; \
        if [ "$netca_log_found" -eq 0 ]; then \
          echo "INFO: NETCA log was not generated under /opt/oracle/cfgtoollogs/netca; continue with database status check."; \
        else \
          echo "INFO: NETCA log output completed; continue with database status check."; \
        fi && \
        /opt/oracle/checkDBStatus.sh

